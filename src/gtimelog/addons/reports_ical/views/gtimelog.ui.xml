<ui_extension target="gtimelog.ui">
  <xpath expr=".//object[@id='view_button']/.." position="before">
    <child>
      <object class="GtkButton" id="download_ical_button">
        <property name="label" translatable="yes">ICS</property>
        <property name="can_focus">True</property>
        <property name="receives_default">True</property>
        <property name="action_name">win.download-ical</property>
        <property name="visible">False</property>
      </object>
      <packing>
        <property name="pack_type">end</property>
        <property name="position">1</property>
      </packing>
    </child>
  </xpath>
</ui_extension>
